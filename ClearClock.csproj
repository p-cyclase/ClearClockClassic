<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ClearClock</AssemblyName>
    <AssemblyTitle>くりくろくらしっく（ClearClockClassic）</AssemblyTitle>
    <Product>くりくろくらしっく（ClearClockClassic）</Product>
    <Version>0.3.1</Version>
    <ApplicationIcon>assets\ClearClock.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>release\</PublishDir>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <None Update="assets\sounds\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>sounds\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>
</Project>
