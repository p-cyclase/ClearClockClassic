<Window x:Class="ClearClock.AlarmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アラームを設定"
        Width="240"
        Height="155"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <TextBox x:Name="HourInput" Width="48" MaxLength="2" TextChanged="TimeInputChanged" />
      <TextBlock VerticalAlignment="Center" Margin="6,0">時</TextBlock>
      <TextBox x:Name="MinuteInput" Width="48" MaxLength="2" TextChanged="TimeInputChanged" />
      <TextBlock VerticalAlignment="Center" Margin="6,0,0,0">分</TextBlock>
    </StackPanel>
    <TextBlock x:Name="InputError" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Firebrick" Visibility="Collapsed">時は 0〜23、分は 0〜59 で入力してください。</TextBlock>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="OkButton" Content="OK" Width="72" IsDefault="True" Click="ConfirmAlarm" />
      <Button Content="キャンセル" Width="72" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
