<Window x:Class="ClearClock.ColorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="色の設定"
        Width="280"
        Height="365"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="84" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="84" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Margin="0,0,0,4">通常時</TextBlock>
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="28" />
        <RowDefinition Height="28" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="58" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="84" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">R</TextBlock>
      <TextBox x:Name="NormalRedInput" Grid.Row="0" Grid.Column="1" MaxLength="3" Width="48" HorizontalAlignment="Left" VerticalAlignment="Center" TextChanged="NormalColorInputChanged" />
      <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">G</TextBlock>
      <TextBox x:Name="NormalGreenInput" Grid.Row="1" Grid.Column="1" MaxLength="3" Width="48" HorizontalAlignment="Left" VerticalAlignment="Center" TextChanged="NormalColorInputChanged" />
      <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">B</TextBlock>
      <TextBox x:Name="NormalBlueInput" Grid.Row="2" Grid.Column="1" MaxLength="3" Width="48" HorizontalAlignment="Left" VerticalAlignment="Center" TextChanged="NormalColorInputChanged" />
      <Border x:Name="NormalPreview" Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Height="84" BorderBrush="LightGray" BorderThickness="1" />
    </Grid>

    <TextBlock Grid.Row="3" Margin="0,0,0,4">通知時</TextBlock>
    <Grid Grid.Row="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="28" />
        <RowDefinition Height="28" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="58" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="84" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">R</TextBlock>
      <TextBox x:Name="NotificationRedInput" Grid.Row="0" Grid.Column="1" MaxLength="3" Width="48" HorizontalAlignment="Left" VerticalAlignment="Center" TextChanged="NotificationColorInputChanged" />
      <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">G</TextBlock>
      <TextBox x:Name="NotificationGreenInput" Grid.Row="1" Grid.Column="1" MaxLength="3" Width="48" HorizontalAlignment="Left" VerticalAlignment="Center" TextChanged="NotificationColorInputChanged" />
      <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">B</TextBlock>
      <TextBox x:Name="NotificationBlueInput" Grid.Row="2" Grid.Column="1" MaxLength="3" Width="48" HorizontalAlignment="Left" VerticalAlignment="Center" TextChanged="NotificationColorInputChanged" />
      <Border x:Name="NotificationPreview" Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Height="84" BorderBrush="LightGray" BorderThickness="1" />
    </Grid>

    <TextBlock x:Name="InputError" Grid.Row="5" Margin="0,8,0,0" Foreground="Firebrick" Visibility="Collapsed">RGB は 0 から 255 までの整数を入力してください。</TextBlock>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="OK" Width="72" IsDefault="True" Click="ConfirmColors" />
      <Button Content="キャンセル" Width="72" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
