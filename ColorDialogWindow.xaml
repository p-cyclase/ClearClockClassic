<Window x:Class="ClearClock.ColorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="色の変更"
        Width="280"
        Height="205"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="28" />
      <RowDefinition Height="28" />
      <RowDefinition Height="28" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="58" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="84" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">R</TextBlock>
    <TextBox x:Name="RedInput" Grid.Row="0" Grid.Column="1" MaxLength="3" Width="48" HorizontalAlignment="Left" VerticalAlignment="Center" TextChanged="ColorInputChanged" />
    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">G</TextBlock>
    <TextBox x:Name="GreenInput" Grid.Row="1" Grid.Column="1" MaxLength="3" Width="48" HorizontalAlignment="Left" VerticalAlignment="Center" TextChanged="ColorInputChanged" />
    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">B</TextBlock>
    <TextBox x:Name="BlueInput" Grid.Row="2" Grid.Column="1" MaxLength="3" Width="48" HorizontalAlignment="Left" VerticalAlignment="Center" TextChanged="ColorInputChanged" />
    <Border x:Name="ColorPreview" Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Height="84" BorderBrush="LightGray" BorderThickness="1" />

    <TextBlock x:Name="InputError" Grid.Row="3" Grid.ColumnSpan="4" Margin="0,8,0,0" Foreground="Firebrick" Visibility="Collapsed">0 から 255 までの整数を入力してください。</TextBlock>

    <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="OK" Width="72" IsDefault="True" Click="ConfirmColor" />
      <Button Content="キャンセル" Width="72" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
